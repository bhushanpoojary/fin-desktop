{
  "name": "fin-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs",
    "dev:test-docking": "concurrently \"npm:dev:renderer\" \"npm:dev:electron:test-docking\"",
    "dev:electron:test-docking": "cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main-test-docking.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder",
    "build:platform": "node electron/platform/build.mjs",
    "dev:platform": "npm run build:platform && cross-env NODE_ENV=development electron electron/platform/platformMain.cjs"
  },
  "dependencies": {
    "flexlayout-react": "^0.8.17",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-open-source-grid": "^1.7.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.0.5"
  }
}
